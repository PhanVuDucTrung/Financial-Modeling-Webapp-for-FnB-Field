# Mặc định KHÔNG cần file .env: backend tự dùng lệnh `claude` đã đăng nhập sẵn trên máy.
# Chỉ điền nếu muốn dùng API key thay thế (key chỉ backend đọc, không bao giờ ra trình duyệt).
# CFS_AI_PROVIDER=auto   # auto | cli | api
# ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=medium
